{
	"name": "df_silver_pacientes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_patients",
						"type": "DatasetReference"
					},
					"name": "sourceBronzePatients"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_patients",
						"type": "DatasetReference"
					},
					"name": "sink"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn"
				},
				{
					"name": "filter"
				},
				{
					"name": "aggregate"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sourceBronzePatients",
				"sourceBronzePatients derive(patient_id = toInteger(trim(patient_id)),",
				"          full_name = trim(regexReplace(replace(replace(regexReplace(full_name, '^([Dd][Rr]|[Mm][Rr][Ss]?|[Mm][Ss]|[Mm][Ii][Ss][Ss])\\\\.?\\\\s+|\\\\s+([Mm][Dd]|[Dd][Dd][Ss]|[Pp][Hh][Dd]|[Jj][Rr]|[Ss][Rr]|[Ii]{2,3})\\\\.?$', ''), 'Â', ''), '\\u00A0', ' '), '\\\\s+', ' ')),",
				"          gender = case(\r",
				"  isNull(gender) || trim(gender) == '' || upper(trim(gender)) == 'NULL', 'No registrado',\r",
				"  lower(trim(gender)) == 'm' || lower(trim(gender)) == 'male' || lower(trim(gender)) == 'masculino', 'Male',\r",
				"  lower(trim(gender)) == 'f' || lower(trim(gender)) == 'female' || lower(trim(gender)) == 'femenino', 'Female',\r",
				"  trim(gender)\r",
				"),",
				"          date_of_birth = iif(\r",
				"  year(coalesce(\r",
				"    toDate(trim(date_of_birth), 'yyyy-MM-dd'),\r",
				"    toDate(trim(date_of_birth), 'yyyy MM dd'),\r",
				"    toDate(trim(date_of_birth), 'yyyy-MM dd'),\r",
				"    toDate(trim(date_of_birth), 'MMMM dd, yyyy'),\r",
				"    toDate(trim(date_of_birth), 'dd-MMM-yyyy'),\r",
				"    toDate(trim(date_of_birth), 'MM-dd-yyyy'),\r",
				"    toDate(trim(date_of_birth), 'MM/dd/yyyy'),\r",
				"    toDate(trim(date_of_birth), 'MM-dd-yy')\r",
				"  )) < 1900,\r",
				"  toDate(null()),\r",
				"  coalesce(\r",
				"    toDate(trim(date_of_birth), 'yyyy-MM-dd'),\r",
				"    toDate(trim(date_of_birth), 'yyyy MM dd'),\r",
				"    toDate(trim(date_of_birth), 'yyyy-MM dd'),\r",
				"    toDate(trim(date_of_birth), 'MMMM dd, yyyy'),\r",
				"    toDate(trim(date_of_birth), 'dd-MMM-yyyy'),\r",
				"    toDate(trim(date_of_birth), 'MM-dd-yyyy'),\r",
				"    toDate(trim(date_of_birth), 'MM/dd/yyyy'),\r",
				"    toDate(trim(date_of_birth), 'MM-dd-yy')\r",
				"  )\r",
				"),",
				"          phone = iif(isNull(phone) || regexReplace(phone, '[^0-9]', '') == '', 'No registrado', right(regexReplace(phone, '[^0-9]', ''), 10)),",
				"          email = iif(\r",
				"  isNull(email) || trim(email) == '' || upper(trim(email)) == 'NULL' || lower(trim(email)) == 'no registrado',\r",
				"  'No registrado',\r",
				"  replace(\r",
				"    replace(\r",
				"      replace(\r",
				"        replace(\r",
				"          replace(\r",
				"            replace(\r",
				"              replace(\r",
				"                replace(\r",
				"                  lower(trim(email)),\r",
				"                  ' at ', '@'\r",
				"                ),\r",
				"                ' ', ''\r",
				"              ),\r",
				"              '\\u00A0', ''\r",
				"            ),\r",
				"            ',', '.'\r",
				"          ),\r",
				"          '..', '.'\r",
				"        ),\r",
				"        '@gmial.', '@gmail.'\r",
				"      ),\r",
				"      '@hotmial.', '@hotmail.'\r",
				"    ),\r",
				"    '@yaho.', '@yahoo.'\r",
				"  )\r",
				"),",
				"          address = iif(\r",
				"  isNull(address) || trim(address) == '' || upper(trim(address)) == 'NULL',\r",
				"  'No registrado',\r",
				"  regexReplace(trim(address), '\\\\s+', ' ')\r",
				"),",
				"          insurance_provider = case(\r",
				"  isNull(insurance_provider) || trim(insurance_provider) == '' || upper(trim(insurance_provider)) == 'NULL' || lower(trim(insurance_provider)) == 'no registrado', 'No registrado',\r",
				"  startsWith(regexReplace(lower(trim(insurance_provider)), '[^a-z]', ''), 'cigna'), 'Cigna',\r",
				"  startsWith(regexReplace(lower(trim(insurance_provider)), '[^a-z]', ''), 'aetna'), 'Aetna',\r",
				"  startsWith(regexReplace(lower(trim(insurance_provider)), '[^a-z]', ''), 'bluecross'), 'BlueCross',\r",
				"  startsWith(regexReplace(lower(trim(insurance_provider)), '[^a-z]', ''), 'medicaid'), 'Medicaid',\r",
				"  startsWith(regexReplace(lower(trim(insurance_provider)), '[^a-z]', ''), 'medicare'), 'Medicare',\r",
				"  regexReplace(lower(trim(insurance_provider)), '[^a-z]', '') == 'uhc' || regexReplace(lower(trim(insurance_provider)), '[^a-z]', '') == 'unitedhealth', 'UnitedHealth',\r",
				"  regexReplace(lower(trim(insurance_provider)), '[^a-z]', '') == 'selfpay' || regexReplace(lower(trim(insurance_provider)), '[^a-z]', '') == 'sinseguro', 'Self-Pay',\r",
				"  trim(insurance_provider)\r",
				")) ~> derivedColumn",
				"derivedColumn filter(!isNull(patient_id)) ~> filter",
				"filter aggregate(groupBy(patient_id),",
				"     full_name = toString(first(full_name)),",
				"          gender = toString(first(gender)),",
				"          date_of_birth = first(date_of_birth),",
				"          phone = toString(first(phone)),",
				"          email = toString(first(email)),",
				"          address = toString(first(address)),",
				"          insurance_provider = toString(first(insurance_provider))) ~> aggregate",
				"aggregate sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink"
			]
		}
	}
}